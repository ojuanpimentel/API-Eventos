generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
 
datasource db {
  provider = "sqlite"
}
 
model Evento {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String
  local     String
  data      DateTime
  palestrantes Palestrante[]
}
 
model Palestrante {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String
  eventos  Evento[]
}